<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Styles -->
    <style name="TextViewHeading" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/dark_navy</item>
    </style>

    <style name="TextViewSubtitle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/dark_navy</item>
    </style>

    <style name="TextViewLabel" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/dark_navy</item>
    </style>

    <style name="TextViewBody" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/dark_navy</item>
    </style>

    <!-- Toolbar Title Style -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Button Styles -->
    <style name="ButtonPrimary" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="backgroundTint">@color/primary_teal</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ButtonLogout" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="backgroundTint">@color/red_logout</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>